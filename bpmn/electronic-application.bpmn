<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="open-jpn-mynumber-electronic-application" targetNamespace="https://etzhayyim.ai/bpmn/open-jpn-mynumber">
  <bpmn:process id="open_jpn_mynumber_electronic_application" name="Myna Portal Electronic Application" isExecutable="true">
    <bpmn:startEvent id="Start_ElectronicApplication" name="Electronic application operation requested" />
    <bpmn:sequenceFlow id="f_app_01" sourceRef="Start_ElectronicApplication" targetRef="Gateway_ApplicationOperation" />
    <bpmn:exclusiveGateway id="Gateway_ApplicationOperation" name="Operation?" />
    <bpmn:sequenceFlow id="f_app_submit" sourceRef="Gateway_ApplicationOperation" targetRef="Task_SubmitApplication" name="submit">
      <bpmn:conditionExpression>=operation = "submit"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_app_status" sourceRef="Gateway_ApplicationOperation" targetRef="Task_GetApplicationStatus" name="status">
      <bpmn:conditionExpression>=operation = "status"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_SubmitApplication" name="Submit electronic application" camunda:topic="com.etzhayyim.apps.openJpnMynumber.submitElectronicApplication"><bpmn:extensionElements><zeebe:taskDefinition type="com.etzhayyim.apps.openJpnMynumber.submitElectronicApplication" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_app_02" sourceRef="Task_SubmitApplication" targetRef="End_ElectronicApplication" />
    <bpmn:serviceTask id="Task_GetApplicationStatus" name="Get electronic application status" camunda:topic="com.etzhayyim.apps.openJpnMynumber.getElectronicApplicationStatus"><bpmn:extensionElements><zeebe:taskDefinition type="com.etzhayyim.apps.openJpnMynumber.getElectronicApplicationStatus" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_app_03" sourceRef="Task_GetApplicationStatus" targetRef="End_ElectronicApplication" />
    <bpmn:endEvent id="End_ElectronicApplication" name="Electronic application audited" />
  </bpmn:process>
</bpmn:definitions>
